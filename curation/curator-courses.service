[Unit]
Description=Curator catalogue and bounded course review worker
After=network.target

[Service]
Type=simple
User=chris
WorkingDirectory=/home/chris/curator-courses
Environment=DOMAIN_INBOX_DIR=/home/chris/zora/data/domain-inbox
ExecStart=/usr/bin/flock --nonblock --no-fork /home/chris/zora/data/domain-inbox/.curator-courses.supervisor.lock /usr/bin/node /home/chris/curator-courses/curation/worker.mjs --watch --recover-stale-lock
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/chris/zora/data/domain-inbox

[Install]
WantedBy=multi-user.target
